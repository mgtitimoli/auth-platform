{
  "name": "auth-platform",
  "private": true,
  "type": "module",
  "packageManager": "yarn@3.8.2",
  "engines": {
    "node": ">=22.22.1"
  },
  "workspaces": [
    "workspaces/*"
  ],
  "scripts": {
    "auth-api:run": "yarn workspace @mgtitimoli/auth-api run",
    "build-all": "yarn build-packages && yarn auth-api:run build",
    "build-packages": "scripts/build-packages.sh",
    "eslint-config:run": "yarn workspace @mgtitimoli/eslint-config run",
    "run-all": "yarn workspaces foreach --verbose run",
    "run-all-parallel": "yarn workspaces foreach --parallel --verbose run",
    "setup": "yarn setup:husky",
    "setup:husky": "husky",
    "utils:run": "yarn workspace @mgtitimoli/utils run",
    "watch": "concurrently --names auth-api,utils --prefix-colors blue,green 'sleep 3 && yarn auth-api:run watch' 'yarn utils:run watch'"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  }
}
