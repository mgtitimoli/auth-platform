{
  "name": "@mgtitimoli/auth-domain",
  "private": true,
  "type": "module",
  "description": "Domain schemas, types and errors shared by the API and the backoffice",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "yarn clean && concurrently --names swc,tsc 'yarn build:swc' 'yarn build:tsc'",
    "build:swc": "swc src -d dist --strip-leading-paths",
    "build:tsc": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "check-types:all": "tsc --noEmit",
    "check-types:files": "tsc-files --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint",
    "test": "vitest run",
    "watch": "yarn clean && concurrently --names swc,tsc,tsc-alias 'yarn watch:swc' 'yarn watch:tsc' 'yarn watch:tsc-alias'",
    "watch:swc": "swc src -d dist --strip-leading-paths --watch",
    "watch:tsc": "tsc -p tsconfig.build.json --preserveWatchOutput --watch",
    "watch:tsc-alias": "tsc-alias -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@mgtitimoli/utils": "workspace:^",
    "@swc/helpers": "^0.5.23",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mgtitimoli/eslint-config": "workspace:^",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@tsconfig/strictest": "^2.0.8",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "tsc-alias": "^1.9.8",
    "tsc-files": "^1.1.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
