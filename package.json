{
  "name": "auth-platform",
  "private": true,
  "type": "module",
  "packageManager": "yarn@3.8.2",
  "engines": {
    "node": ">=22.22.1"
  },
  "workspaces": [
    "workspaces/*"
  ],
  "scripts": {
    "auth-api-tools:run": "yarn workspace @mgtitimoli/auth-api-tools run",
    "auth-api:run": "yarn workspace @mgtitimoli/auth-api run",
    "auth-backoffice:run": "yarn workspace @mgtitimoli/auth-backoffice run",
    "auth-domain:run": "yarn workspace @mgtitimoli/auth-domain run",
    "build-all": "yarn build-packages && yarn auth-api:run build && yarn auth-backoffice:run build",
    "build-packages": "scripts/build-packages.sh",
    "eslint-config:run": "yarn workspace @mgtitimoli/eslint-config run",
    "run-all": "yarn workspaces foreach --verbose run",
    "run-all-parallel": "yarn workspaces foreach --parallel --verbose run",
    "setup": "yarn setup:husky",
    "setup:husky": "husky",
    "test:e2e": "scripts/test-e2e.sh",
    "utils:run": "yarn workspace @mgtitimoli/utils run",
    "watch": "yarn build-packages && concurrently --names auth-api,auth-api-tools,auth-backoffice,auth-domain,utils --prefix-colors blue,yellow,cyan,magenta,green 'yarn auth-api:run watch' 'yarn auth-api-tools:run watch' 'yarn auth-backoffice:run dev' 'yarn auth-domain:run watch' 'yarn utils:run watch'"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  }
}
