{
  "name": "@mgtitimoli/auth-backoffice",
  "private": true,
  "type": "module",
  "description": "Back office to sign up, sign in and manage users",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "next build && cp -r .next/static .next/standalone/workspaces/auth-backoffice/.next/",
    "check-types:all": "next typegen && tsc --noEmit",
    "check-types:files": "next typegen && tsc-files --noEmit next-env.d.ts",
    "dev": "next dev --port 3000",
    "lint": "eslint",
    "start": "PORT=3000 node .next/standalone/workspaces/auth-backoffice/server.js",
    "test:e2e": "yarn build && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.21.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@mgtitimoli/eslint-config": "workspace:^",
    "@playwright/test": "^1.64.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/next-plugin": "2.5.2",
    "eslint": "^9.39.5",
    "tsc-files": "^1.1.4",
    "typescript": "~6.0.3"
  }
}
