{
  "name": "@mgtitimoli/auth-api",
  "private": true,
  "type": "module",
  "description": "REST API for users and sessions",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths",
    "check-types:all": "tsc --noEmit",
    "check-types:files": "tsc-files --noEmit",
    "container": "scripts/environment.sh run scripts/container.sh",
    "database": "scripts/environment.sh run scripts/database.sh",
    "env": "scripts/environment.sh",
    "lint": "eslint",
    "start": "node --enable-source-maps --env-file=.env dist/serve.js",
    "test": "scripts/environment.sh run --environment test yarn database start && vitest run",
    "watch": "tsx --env-file=.env --inspect --watch src/serve.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.1",
    "@mgtitimoli/auth-domain": "workspace:^",
    "@mgtitimoli/utils": "workspace:^",
    "@swc/helpers": "^0.5.23",
    "hono": "^4.13.13",
    "hono-openapi": "^1.5.0",
    "hono-pino": "^0.10.3",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mgtitimoli/eslint-config": "workspace:^",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "kysely-ctl": "^0.21.0",
    "tsc-files": "^1.1.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
